# ==============================================================================
# AMW (Amit Mobile World) - Environment Variables Configuration
# ==============================================================================
# Copy this file to backend/.env and frontend/.env respectively, or configure in
# your production deployment environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Place in backend/.env)
# ------------------------------------------------------------------------------

# Application Mode (Set to False in production)
DEBUG=True

# Django Secret Key (Generate a secure random key for production)
SECRET_KEY=replace-with-a-secure-50-character-secret-key-in-production

# Allowed Hosts (Comma-separated or '*' for dev)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://yourdomain.com

# Database Selection: 'mysql' or 'sqlite'
DB_TYPE=sqlite

# MySQL Database Settings (Required when DB_TYPE=mysql)
DB_NAME=amw_db
DB_USER=amw_user
DB_PASSWORD=your_strong_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# SimpleJWT Token Lifetime (Optional defaults: Access=60m, Refresh=1d)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1

# Static & Media Storage
STATIC_ROOT=staticfiles
MEDIA_ROOT=media

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Place in frontend/.env)
# ------------------------------------------------------------------------------

# REST API Base URL
VITE_API_BASE_URL=http://localhost:8000

